@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "Backoffice Configuration" {

  class Manufacturer <<AggregateRoot>> {
    +manufacturerId: ManufacturerId
    +name: String
    +country: String
  }

  class EngineModel <<AggregateRoot>> {
    +engineModelId: EngineModelId
    +manufacturerId: ManufacturerId
    +name: String
    +type: String
    +power: Decimal
    +fuelType: String
    +efficiency: Decimal
  }

  class AircraftModel <<AggregateRoot>> {
    +aircraftModelId: AircraftModelId
    +manufacturerId: ManufacturerId
    +modelName: String
    +type: AircraftType
    +motorization: String
    +serviceCeiling: Decimal
    +cruiseSpeed: Decimal
    +wingArea: Decimal
    +maximumRange: Decimal
    +aspectRatio: Decimal
  }

  class AircraftModelId <<ValueObject>> {
    +code: String
  }

  class Weight <<ValueObject>> {
    +emptyWeight: Decimal
    +maximumZeroFuelWeight: Decimal
    +maximumTakeoffWeight: Decimal
  }

  class Fuel <<ValueObject>> {
    +maximumFuelCapacity: Decimal
  }

  class Coefficient <<ValueObject>> {
    +dragCoefficient: Decimal
    +liftCoefficient: Decimal
  }

  class CertifiedEngine <<Entity>> {
    +engineModelId: EngineModelId
  }

  class AirControlArea <<AggregateRoot>> {
    +airControlAreaId: AirControlAreaId
    +code: String
    +name: String
    +minimumReserveFuelRule: Decimal
  }

  class AirControlAreaBoundary <<ValueObject>> {
    +minLatitude: Decimal
    +maxLatitude: Decimal
    +minLongitude: Decimal
    +maxLongitude: Decimal
  }

  class Airport <<AggregateRoot>> {
    +iataCode: IataCode <<ID>>
    +icaoCode: IcaoCode
    +name: String
    +town: String
    +country: String
    +elevation: Elevation
  }

  class Coordinates <<ValueObject>> {
    +latitude: Decimal
    +longitude: Decimal
  }

  class IataCodeAirport <<ValueObject>> {
    +code: String
  }

  class IcaoCodeAirport <<ValueObject>> {
    +code: String
  }

  enum AircraftType {
    PASSENGER
    CARGO
    MIXED
  }
}

AircraftModel "1" *-- "1..*" CertifiedEngine
AircraftModel "1" *-- "1" Weight
AircraftModel "1" *-- "1" Fuel
AircraftModel "1" *-- "1" Coefficient
AircraftModel "1" *-- "1" AircraftModelId

AirControlArea "1" *-- "1" AirControlAreaBoundary
Airport "1" *-- "1" Coordinates
Airport "1" *-- "1" IataCodeAirport
Airport "1" *-- "1" IcaoCodeAirport

EngineModel --> Manufacturer : made by >
AircraftModel --> Manufacturer : made by >
CertifiedEngine --> EngineModel : certified model >
Airport --> AirControlArea : belongs to >

@enduml