@startuml
hide circle
skinparam classAttributeIconSize 0
skinparam classBorderColor #888888
skinparam classBackgroundColor #FAFAFA
skinparam packageBorderColor #AAAAAA
skinparam packageBackgroundColor transparent
skinparam ArrowColor #555555
skinparam shadowing false

' =============================================
' PACKAGE: Identity & Access
' =============================================
package "Identity & Access" {

  class User {
    +userId: UserId
    +name: String
    +email: Email
    +phoneNumber: PhoneNumber
    +status: UserStatus
    +securityClearanceExpiryDate: Date
    +lastSkillsAssessmentDate: Date
  }

  class Role {
    +roleId: RoleId
    +name: String
  }

  enum UserStatus {
    ACTIVE
    DISABLED
  }

  class Email <<ValueObject>> {
    +value: String
  }

  class PhoneNumber <<ValueObject>> {
    +value: String
  }
}

' =============================================
' PACKAGE: Backoffice Configuration
' =============================================
package "Backoffice Configuration" {

  class Manufacturer {
    +manufacturerId: ManufacturerId
    +name: String
    +country: String
    ' Note: same entity can be aircraft AND engine manufacturer
  }

  class EngineModel {
    +engineModelId: EngineModelId
    +name: String
    +type: String
    +power: Decimal
    +fuelType: String
    +efficiency: Decimal
  }

  class AircraftModel {
    +aircraftModelId: AircraftModelId
    +modelName: String
    +type: AircraftType
    +motorization: String
    +emptyWeight: Decimal
    +maximumTakeoffWeight: Decimal
    +maximumZeroFuelWeight: Decimal
    +maximumFuelCapacity: Decimal
    +serviceCeiling: Decimal
    +cruiseSpeed: Decimal
    +wingArea: Decimal
    +dragCoefficient: Decimal
    +liftCoefficient: Decimal
    +maximumRange: Decimal
    +aspectRatio: Decimal
  }

  class AirControlArea {
    +airControlAreaId: AirControlAreaId
    +code: String
    +name: String
    +minimumReserveFuelRule: Decimal
  }

  class Airport {
    +airportId: AirportId
    +name: String
    +town: String
    +country: String
    +iataCode: String
    +icaoCode: String
    +elevation: Decimal
  }

  class GeographicBoundary <<ValueObject>> {
    +description: String
  }

  class Coordinates <<ValueObject>> {
    +latitude: Decimal
    +longitude: Decimal
  }

  enum AircraftType {
    PASSENGER
    CARGO
    MIXED
  }
}

' =============================================
' PACKAGE: Air Transport Operations
' =============================================
package "Air Transport Operations" {

  class AirTransportCompany {
    +companyId: CompanyId
    +name: String
    +iataCode: String
    +icaoCode: String
  }

  class CompanyCollaborator {
    +collaboratorId: CollaboratorId
    +position: String
    +status: CollaboratorStatus
  }

  class Pilot {
    +pilotId: PilotId
    +status: PilotStatus
  }

  class Aircraft {
    +aircraftId: AircraftId
    +registration: String
    +countryOfRegistration: String
    +operationalStatus: AircraftOperationalStatus
    +crewSize: Integer
  }

  class FlightRoute {
    +flightRouteId: FlightRouteId
    +code: String
    ' code format: company initials + up to 4 digits (e.g. TP123)
    +type: FlightType
    ' [CHANGED] type belongs to FlightRoute, not FlightPlan
    ' A charter route is a separate route from a regular one
    ' (see client Q&A: TO3910 vs TO3914 example)
    +activeFrom: Date
    +deactivatedFrom: Date
  }

  class CabinConfiguration <<ValueObject>> {
    +economySeats: Integer
    +businessSeats: Integer
    +firstClassSeats: Integer
  }

  enum CollaboratorStatus {
    ACTIVE
    DISABLED
  }

  enum PilotStatus {
    ACTIVE
    INACTIVE
  }

  enum AircraftOperationalStatus {
    ACTIVE
    MAINTENANCE
    RETIRED
  }

  enum FlightType {
    REGULAR
    CHARTER
  }
}

' =============================================
' PACKAGE: Flight Planning
' [CHANGED] Added Flight entity between FlightRoute and FlightPlan
' Hierarchy: FlightRoute -1:N-> Flight -1:N-> FlightPlan
' =============================================
package "Flight Planning" {

  ' [NEW] Flight = concrete instance of a FlightRoute on a specific date/time
  ' e.g. TP123 on Tuesday 24th March 2026 06:45
  class Flight {
    +flightId: FlightId
    +designator: String
    ' format: xxn(n)(n)(n)(a)  e.g. TP1234A
    +scheduledDate: Date
    +scheduledDepartureTime: Time
  }

  class FlightPlan {
    +flightPlanId: FlightPlanId
    ' [CHANGED] flightType removed — now lives in FlightRoute
    +status: FlightPlanStatus
    +createdAt: DateTime
    +fuelQuantity: Decimal
    +fuelUnit: String
  }

  ' [CHANGED] RouteDefinition is a Value Object / internal structure of FlightPlan
  ' Segments and nodes/junctions are part of the DSL specification,
  ' not managed independently (confirmed by client Q&A 18/03)
  class RouteDefinition <<ValueObject>> {
    +originCode: String
    +destinationCode: String
    ' segments and nodes live here as DSL-parsed structures
  }

  class AltitudeSlot <<ValueObject>> {
    +minAltitude: Decimal
    +maxAltitude: Decimal
    +width: Decimal
  }

  class FuelInfo <<ValueObject>> {
    +quantity: Decimal
    +unit: String
  }

  enum FlightPlanStatus {
    DRAFT
    VALIDATED
    REJECTED
  }
}

' =============================================
' PACKAGE: Weather Service
' =============================================
package "Weather Service" {

  class WeatherData {
    +weatherDataId: WeatherDataId
    +date: Date
    +time: Time
    +windSpeed: Decimal
    +windDirection: Decimal
    +temperature: Decimal
    +pressure: Decimal
    +humidity: Decimal
    +altitude: Decimal
  }

  class WeatherSource {
    +weatherSourceId: WeatherSourceId
    +name: String
    +type: String
    +format: String
  }

  class WeatherImportBatch {
    +batchId: BatchId
    +importedAt: DateTime
    +status: ImportBatchStatus
    +importedRecords: Integer
  }

  enum ImportBatchStatus {
    PENDING
    COMPLETED
    FAILED
  }
}

' =============================================
' PACKAGE: Flight Simulation
' =============================================
package "Flight Simulation" {

  class Simulation {
    +simulationId: SimulationId
    +startTime: DateTime
    +endTime: DateTime
    +timeStep: Integer
    +safetyThreshold: Decimal
    +status: SimulationStatus
  }

  class SimulatedFlight {
    +simulatedFlightId: SimulatedFlightId
    +currentVelocity: Decimal
    +currentAltitude: Decimal
    +currentStatus: SimulatedFlightStatus
  }

  class Position <<ValueObject>> {
    +latitude: Decimal
    +longitude: Decimal
    +altitude: Decimal
    +timestamp: DateTime
  }

  class SafetyViolation {
    +violationId: ViolationId
    +timestamp: DateTime
    +severity: String
    +type: String
  }

  class SimulationReport {
    +reportId: ReportId
    +totalFlights: Integer
    +finalValidationResult: String
    +generatedAt: DateTime
    +fileLocation: String
  }

  enum SimulationStatus {
    CREATED
    RUNNING
    FINISHED
    FAILED
  }

  enum SimulatedFlightStatus {
    READY
    RUNNING
    COMPLETED
    ABORTED
  }
}

' =========================
' Identity relations
' =========================
User "1" -- "1..*" Role : has >
User *-- Email
User *-- PhoneNumber

' =========================
' Backoffice relations
' =========================
' Same Manufacturer can produce both aircraft models and engine models
Manufacturer "1" -- "0..*" EngineModel : produces >
Manufacturer "1" -- "0..*" AircraftModel : produces >
AirControlArea *-- GeographicBoundary
Airport *-- Coordinates
Airport "0..*" --> "1" AirControlArea : belongs to >
AircraftModel "1" -right- "1..*" EngineModel : certified engines >

' =========================
' Air Transport Operations relations
' =========================
AirTransportCompany "1" -- "0..*" CompanyCollaborator : has >
AirTransportCompany "1" -- "0..*" Pilot : has >
AirTransportCompany "1" -- "0..*" Aircraft : owns >
AirTransportCompany "1" -- "0..*" FlightRoute : manages >

CompanyCollaborator "1" --> "1" User : user >
Pilot "1" --> "1" User : user >
Pilot "0..*" -- "1..*" AircraftModel : certified for >

Aircraft "0..*" -up-> "1" AircraftModel : model >
Aircraft "0..*" --> "1" EngineModel : engine >
Aircraft *-- CabinConfiguration

' FlightRoute has origin and destination airports
FlightRoute "0..*" --> "1" Airport : origin >
FlightRoute "0..*" --> "1" Airport : destination >

' =========================
' Flight Planning relations
' [CHANGED] Full hierarchy: FlightRoute -> Flight -> FlightPlan
' =========================

' One FlightRoute has many Flight instances (different dates/times)
FlightRoute "1" -up- "0..*" Flight : instantiates >

' One Flight may have multiple FlightPlans (draft, validated, rejected)
' but only one validated at a time
Flight "1" -up- "0..*" FlightPlan : has >

' FlightPlan references aircraft and pilot
FlightPlan "0..*" --> "1" Aircraft : aircraft >
FlightPlan "0..*" --> "1" Pilot : pilot >

' RouteDefinition is composed inside FlightPlan
' Segments and nodes are part of DSL — not standalone domain entities
FlightPlan "1" *-- "1" RouteDefinition
RouteDefinition "1" o-up- "1..*" AltitudeSlot
FlightPlan "1" *-- "1" FuelInfo

' =========================
' Weather relations
' =========================
WeatherData "0..*" --> "1" AirControlArea : area >
WeatherData "0..*" --> "1" WeatherSource : source >
WeatherImportBatch "0..*" -up-> "1" WeatherSource : source >
WeatherImportBatch "0..*" --> "1" User : imported by >

' =========================
' Simulation relations
' =========================
Simulation "0..*" --> "1" AirControlArea : area >
Simulation "1" *-- "1..*" SimulatedFlight : flights >
Simulation "1" *-- "0..*" SafetyViolation : violations >
Simulation "1" *-- "0..1" SimulationReport : report >

SimulatedFlight "0..*" --> "1" FlightPlan : based on >
SimulatedFlight *-- Position : current position >

SafetyViolation "0..*" -- "2..*" SimulatedFlight : involves >
SafetyViolation *-- Position

@enduml
