@startuml
skinparam classAttributeIconSize 0
skinparam classBorderColor #888888
skinparam classBackgroundColor #FAFAFA
skinparam packageBorderColor #AAAAAA
skinparam packageBackgroundColor transparent
skinparam ArrowColor #555555
skinparam shadowing false

' =============================================
' PACKAGE: Identity & Access
' =============================================
package "Identity & Access" {

  class User <<AggregateRoot>> {
    +userId: UserId
    +name: String
    +email: Email
    +phoneNumber: PhoneNumber
    +status: UserStatus
    +securityClearanceExpiryDate: Date
    +lastSkillsAssessmentDate: Date
  }

  class Role <<AggregateRoot>> {
    +roleId: RoleId
    +name: String
  }

  enum UserStatus {
    ACTIVE
    DISABLED
  }

  class Email <<ValueObject>> {
    +value: String
  }

  class PhoneNumber <<ValueObject>> {
    +value: String
  }
}

' =============================================
' PACKAGE: Backoffice Configuration
' =============================================
package "Backoffice Configuration" {

  class Manufacturer <<AggregateRoot>> {
    +manufacturerId: ManufacturerId
    +name: String
    +country: String
  }

  class EngineModel <<AggregateRoot>> {
    +engineModelId: EngineModelId
    +name: String
    +type: String
    +power: Decimal
    +fuelType: String
    +efficiency: Decimal
  }

  class AircraftModel <<AggregateRoot>> {
    +aircraftModelId: AircraftModelId
    +modelName: String
    +type: AircraftType
    +motorization: String
    +emptyWeight: Decimal
    +maximumTakeoffWeight: Decimal
    +maximumZeroFuelWeight: Decimal
    +maximumFuelCapacity: Decimal
    +serviceCeiling: Decimal
    +cruiseSpeed: Decimal
    +wingArea: Decimal
    +dragCoefficient: Decimal
    +liftCoefficient: Decimal
    +maximumRange: Decimal
    +aspectRatio: Decimal
  }

  class AirControlArea <<AggregateRoot>> {
    +airControlAreaId: AirControlAreaId
    +code: String
    +name: String
    +minimumReserveFuelRule: Decimal
  }

  class Airport <<AggregateRoot>> {
    +airportId: AirportId
    +name: String
    +town: String
    +country: String
    +iataCode: String
    +icaoCode: String
    +elevation: Decimal
  }

  class GeographicBoundary <<ValueObject>> {
    +description: String
  }

  class Coordinates <<ValueObject>> {
    +latitude: Decimal
    +longitude: Decimal
  }

  enum AircraftType {
    PASSENGER
    CARGO
    MIXED
  }
}

' =============================================
' PACKAGE: Air Transport Operations
' =============================================
package "Air Transport Operations" {

  class AirTransportCompany <<AggregateRoot>> {
    +companyId: CompanyId
    +name: String
    +iataCode: String
    +icaoCode: String
  }

  class CompanyCollaborator <<Entity>> {
    +collaboratorId: CollaboratorId
    +position: String
    +status: CollaboratorStatus
  }

  class Pilot <<Entity>> {
    +pilotId: PilotId
    +status: PilotStatus
  }

  class Aircraft <<Entity>> {
    +aircraftId: AircraftId
    +registration: String
    +countryOfRegistration: String
    +operationalStatus: AircraftOperationalStatus
    +crewSize: Integer
  }

  class FlightRoute <<AggregateRoot>> {
    +flightRouteId: FlightRouteId
    +code: String
    +type: FlightType
    +activeFrom: Date
    +deactivatedFrom: Date
  }

  class CabinConfiguration <<ValueObject>> {
    +economySeats: Integer
    +businessSeats: Integer
    +firstClassSeats: Integer
  }

  enum CollaboratorStatus {
    ACTIVE
    DISABLED
  }

  enum PilotStatus {
    ACTIVE
    INACTIVE
  }

  enum AircraftOperationalStatus {
    ACTIVE
    MAINTENANCE
    RETIRED
  }

  enum FlightType {
    REGULAR
    CHARTER
  }
}

' =============================================
' PACKAGE: Flight Planning
' =============================================
package "Flight Planning" {

  class FlightPlan <<AggregateRoot>> {
    +flightPlanId: FlightPlanId
    +status: FlightPlanStatus
    +createdAt: DateTime
  }

  class Flight <<Entity>> {
    +flightId: FlightId
    +designator: String
    +scheduledDate: Date
    +scheduledDepartureTime: Time
  }

  class RouteDefinition <<ValueObject>> {
    +originCode: String
    +destinationCode: String
  }

  class AltitudeSlot <<ValueObject>> {
    +minAltitude: Decimal
    +maxAltitude: Decimal
    +width: Decimal
  }

  class FuelInfo <<ValueObject>> {
    +quantity: Decimal
    +unit: String
  }

  enum FlightPlanStatus {
    DRAFT
    VALIDATED
    REJECTED
  }
}

' =============================================
' PACKAGE: Weather Service
' =============================================
package "Weather Service" {

  class WeatherSource <<AggregateRoot>> {
    +weatherSourceId: WeatherSourceId
    +name: String
    +type: String
    +format: String
  }

  class WeatherImportBatch <<AggregateRoot>> {
    +batchId: BatchId
    +importedAt: DateTime
    +status: ImportBatchStatus
    +importedRecords: Integer
  }

  class WeatherData <<Entity>> {
    +weatherDataId: WeatherDataId
    +date: Date
    +time: Time
    +windSpeed: Decimal
    +windDirection: Decimal
    +temperature: Decimal
    +pressure: Decimal
    +humidity: Decimal
    +altitude: Decimal
  }

  enum ImportBatchStatus {
    PENDING
    COMPLETED
    FAILED
  }
}

' =============================================
' PACKAGE: Flight Simulation
' =============================================
package "Flight Simulation" {

  class Simulation <<AggregateRoot>> {
    +simulationId: SimulationId
    +startTime: DateTime
    +endTime: DateTime
    +timeStep: Integer
    +safetyThreshold: Decimal
    +status: SimulationStatus
  }

  class SimulatedFlight <<Entity>> {
    +simulatedFlightId: SimulatedFlightId
    +currentVelocity: Decimal
    +currentAltitude: Decimal
    +currentStatus: SimulatedFlightStatus
  }

  class Position <<ValueObject>> {
    +latitude: Decimal
    +longitude: Decimal
    +altitude: Decimal
    +timestamp: DateTime
  }

  class SafetyViolation <<Entity>> {
    +violationId: ViolationId
    +timestamp: DateTime
    +severity: String
    +type: String
  }

  class SimulationReport <<ValueObject>> {
    +reportId: ReportId
    +totalFlights: Integer
    +finalValidationResult: String
    +generatedAt: DateTime
    +fileLocation: String
  }

  enum SimulationStatus {
    CREATED
    RUNNING
    FINISHED
    FAILED
  }

  enum SimulatedFlightStatus {
    READY
    RUNNING
    COMPLETED
    ABORTED
  }
}

' =========================
' Identity relations
' =========================
User "1" --> "1..*" Role : has >
User "1" *--> "1" Email
User "1" *--> "1" PhoneNumber

' =========================
' Backoffice relations
' =========================
Manufacturer "1" --> "0..*" EngineModel : produces >
Manufacturer "1" --> "0..*" AircraftModel : produces >
AirControlArea "1" *--> "1" GeographicBoundary
Airport "1" *--> "1" Coordinates
Airport "0..*" --> "1" AirControlArea : belongs to >
AircraftModel "1" --> "1..*" EngineModel : certified engines >

' =========================
' Air Transport Operations relations
' =========================
AirTransportCompany "1" *--> "0..*" CompanyCollaborator : has >
AirTransportCompany "1" *--> "0..*" Pilot : has >
AirTransportCompany "1" *--> "0..*" Aircraft : owns >
AirTransportCompany "1" *--> "0..*" FlightRoute : manages >

CompanyCollaborator "0..*" --> "1" User : user >
Pilot "0..*" --> "1" User : user >

Aircraft "0..*" --> "1" AircraftModel : model >
Aircraft "0..*" --> "1" EngineModel : engine >
Aircraft "1" *--> "1" CabinConfiguration

FlightRoute "0..*" --> "1" Airport : origin >
FlightRoute "0..*" --> "1" Airport : destination >

' =========================
' Flight Planning relations
' =========================
FlightPlan "1" *--> "0..*" Flight : flights >
FlightPlan "0..*" --> "1" FlightRoute : route >
FlightPlan "0..*" --> "1" Aircraft : aircraft >
FlightPlan "0..*" --> "1" Pilot : pilot >
FlightPlan "1" *--> "1" RouteDefinition
FlightPlan "1" *--> "1" FuelInfo
RouteDefinition "1" *--> "1..*" AltitudeSlot

' =========================
' Weather relations
' =========================
WeatherImportBatch "1" *--> "0..*" WeatherData : imports >
WeatherImportBatch "0..*" --> "1" WeatherSource : source >
WeatherImportBatch "0..*" --> "1" User : imported by >
WeatherData "0..*" --> "1" AirControlArea : area >

' =========================
' Simulation relations
' =========================
Simulation "0..*" --> "1" AirControlArea : area >
Simulation "1" *--> "1..*" SimulatedFlight : flights >
Simulation "1" *--> "0..*" SafetyViolation : violations >
Simulation "1" *--> "0..1" SimulationReport : report >

SimulatedFlight "0..*" --> "1" FlightPlan : based on >
SimulatedFlight "1" *--> "1" Position : current position >

SafetyViolation "1" *--> "1" Position : location >

@enduml