@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "Air Transport Operations" {

  class AirTransportCompany <<AggregateRoot>> {
    +name: String
  }

  class IataCodeCompany <<ValueObject>> {
    +code: String
  }

  class IcaoCodeCompany <<ValueObject>> {
    +code: String
  }

  class Aircraft <<AggregateRoot>> {
    +registration: AircraftRegistration <<ID>>
    +companyIataCode: IataCodeCompany
    +aircraftModelId: AircraftModelId
    +engineModelId: EngineModelId
    +countryOfRegistration: String
    +operationalStatus: AircraftOperationalStatus
    +crewSize: Integer
  }

  class CabinConfiguration <<ValueObject>> {
    +economySeats: Integer
    +businessSeats: Integer
    +firstClassSeats: Integer
  }

  class FlightRoute <<AggregateRoot>> {
    +flightRouteId: FlightRouteId
    +company: IataCodeCompany
    +originAirportId: AirportId
    +destinationAirportId: AirportId
  }

  class RouteSegment <<Entity>> {
    +segmentId: Long <<ID>>
    +startNodeCoords: Coordinates
    +endNodeCoords: Coordinates
    +maxSpeed: Integer
  }

  class Wind <<ValueObject>> {
    +directionAngle: Integer
    +speed: Decimal
  }

  class Flight <<AggregateRoot>> {
    +flightId: FlightId
    +flightRouteId: FlightRouteId
    +type: FlightType
    +status: FlightStatus
  }

  class AltitudeRange <<ValueObject>> {
    +minAltitude: Decimal
    +maxAltitude: Decimal
    +width: Decimal
  }

  class FlightScheduleEntry <<Entity>> {
    +dayOfWeek: DayOfWeek
    +departureTime: Time
  }

  enum AircraftOperationalStatus {
    ACTIVE
    MAINTENANCE
    RETIRED
  }

  enum FlightType {
    REGULAR
    CHARTER
  }

  enum FlightStatus {
    SCHEDULED
    CANCELLED
    COMPLETED
  }
}

package "Flight Planning" {

  class FlightPlan <<AggregateRoot>> {
    +flightPlanId: FlightPlanId
    +flightId: FlightId
    +aircraftRegistration: AircraftRegistration
    +pilotId: PilotId
    +status: FlightPlanStatus
    +createdAt: DateTime
  }

  class FlightLegPlan <<Entity>> {
    +legId: LegId
    +departureAirport: AirportId
    +arrivalAirport: AirportId
    +departureDateTime: DateTime
    +arrivalDateTime: DateTime
  }

  class FuelInfo <<ValueObject>> {
    +quantity: Decimal
    +unit: String
  }

  class FlightPlanFile <<ValueObject>> {
    +format: String
    +contentReference: String
  }

  enum FlightPlanStatus {
    DRAFT
    VALIDATED
    REJECTED
  }
}

AirTransportCompany "1" *-- "1" IataCodeCompany : +iataCode <<ID>>
AirTransportCompany "1" *-- "1" IcaoCodeCompany : +icaoCode

Aircraft "1" *-- "1" CabinConfiguration

FlightRoute "1" *-- "1..*" RouteSegment

Flight "1" *-- "0..*" FlightScheduleEntry
Flight --> FlightRoute : follows >

FlightPlan "1" *-- "1..*" FlightLegPlan
FlightLegPlan "1" *-- "1" FuelInfo

FlightPlan "1" *-- "0..1" FlightPlanFile

RouteSegment "1" *-- "1..*" AltitudeRange
RouteSegment "1" *-- "1" Wind

FlightPlan --> Flight : plans instance of >
FlightPlan --> Aircraft : assigned aircraft >

Aircraft --> AirTransportCompany : belongs to >
FlightRoute --> AirTransportCompany : owned by >
@enduml