@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "Weather Service" {

  class WeatherSource <<AggregateRoot>> {
    +weatherSourceId: WeatherSourceId
    +name: String
    +type: String
    +format: String
  }

  class WeatherImportBatch <<AggregateRoot>> {
    +batchId: BatchId
    +weatherSourceId: WeatherSourceId
    +importedByUserId: UserId
    +importedAt: DateTime
    +status: ImportBatchStatus
    +importedRecords: Integer
  }

  class ImportedWeatherRecord <<Entity>> {
    +weatherDataId: WeatherDataId
  }

  class WeatherData <<AggregateRoot>> {
    +weatherDataId: WeatherDataId
    +airControlAreaId: AirControlAreaId
    +date: Date
    +time: Time
    +windSpeed: Decimal
    +windDirection: Decimal
    +temperature: Decimal
    +pressure: Decimal
    +humidity: Decimal
    +altitude: Decimal
  }

  enum ImportBatchStatus {
    PENDING
    COMPLETED
    FAILED
  }
}

package "Simulation Integration" {

  class Simulation <<AggregateRoot>> {
    +simulationId: SimulationId
    +airControlAreaId: AirControlAreaId
    +startTime: DateTime
    +endTime: DateTime
    +timeStep: Integer
    +safetyThreshold: Decimal
    +status: SimulationStatus
  }

  class SimulatedFlightInput <<ValueObject>> {
    +flightPlanId: FlightPlanId
  }

  class SimulationReport <<AggregateRoot>> {
    +reportId: ReportId
    +simulationId: SimulationId
    +totalFlights: Integer
    +finalValidationResult: SimulationValidationResult
    +generatedAt: DateTime
    +fileLocation: ReportFilePath
  }

  class FlightExecutionSummary <<ValueObject>> {
    +flightId: String
    +executionStatus: String
  }

  class SafetyViolationSummary <<ValueObject>> {
    +timestamp: Integer
    +type: String
    +position: String
    +details: String
  }

  class ReportFilePath <<ValueObject>> {
    +value: String
  }

  enum SimulationValidationResult {
    PASS
    FAIL
  }

  enum SimulationStatus {
    CREATED
    RUNNING
    FINISHED
    FAILED
  }
}

package "Reporting" {

  abstract class Report {
    +type: String
    +title: String
    +period: YearMonth
    +generatedAt: DateTime
  }

  class MonthlyStatisticsReport {
  }

  class ReportSection <<ValueObject>> {
    +title: String
  }

  class ReportMetadata <<AggregateRoot>> {
    +reportId: String
    +reportType: String
    +title: String
    +period: YearMonth
    +generatedAt: DateTime
    +format: String
    +fileLocation: String
  }
}

WeatherImportBatch "1" *-- "0..*" ImportedWeatherRecord
ImportedWeatherRecord --> WeatherData : imported data >

WeatherImportBatch --> WeatherSource : source >
WeatherImportBatch --> User : imported by >
WeatherData --> AirControlArea : area >

Simulation "1" *-- "1..*" SimulatedFlightInput
SimulationReport "1" *-- "0..*" FlightExecutionSummary
SimulationReport "1" *-- "0..*" SafetyViolationSummary
SimulationReport "1" *-- "1" ReportFilePath

Simulation --> AirControlArea : simulated area >
SimulatedFlightInput --> FlightPlan : input >
SimulationReport --> Simulation : result of >
SimulationReport --> SimulationValidationResult : validation result >

MonthlyStatisticsReport --|> Report
Report "1" *-- "1..*" ReportSection
ReportMetadata ..> Report : describes generated report >

@enduml
